{
  "name": "refine-alignment",
  "nodes": [
    { "id": "n1", "name": "Manual Trigger", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {} },
    { "id": "n2", "name": "Load YAML Config", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [260, 0], "parameters": { "jsCode": "// Load configs/<EDITION>.yaml: target_language, corpus, llm_provider, llm_model,\n// batch_mode, max_output_tokens, temperature, max_api_retries, retry_* overrides,\n// alignments_root, range filters (--book/--chapter/--verse).\nreturn items;" } },
    { "id": "n3", "name": "Load Source + Target TSV", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [520, 0], "parameters": { "jsCode": "// Parse SBLGNT.tsv / WLCM.tsv (source_verses) and the edition TSV (target_verses)\n// into token maps keyed by verse id.\nreturn items;" } },
    { "id": "n4", "name": "Resolve Verse IDs", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [780, 0], "parameters": { "jsCode": "// NT: intersect source/target verse ids directly.\n// OT: iterate target_verses keys, resolve each to its Hebrew verse via\n// MigrateTarget.source_verse (+ source_verse_range_end for multi-source-verse spans),\n// since WLCM and the translation use different versification.\nreturn items;" } },
    { "id": "n5", "name": "Group Into Chapters", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1040, 0], "parameters": { "jsCode": "// Bucket verse ids into BBCCC chapter groups (one output file per chapter).\nreturn items;" } },
    { "id": "n6", "name": "For Each Chapter", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [1300, 0], "parameters": { "batchSize": 1, "options": {} } },
    { "id": "n7", "name": "Assemble Prompt", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1560, 0], "parameters": { "jsCode": "// get_language_config(target_language) + detect_phenomena(chapter tokens)\n// selects the conditional prompt blocks, then assembles the full LLM prompt.\nreturn items;" } },
    { "id": "n8", "name": "Batch Mode?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1820, 0], "parameters": { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "leftValue": "={{$json.batchMode}}", "rightValue": "async", "operator": { "type": "string", "operation": "equals" } } ] } } },
    { "id": "n9", "name": "Submit Batch API Job", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2080, -150], "parameters": { "method": "POST", "url": "={{$json.batchApiUrl}}", "options": {} } },
    { "id": "n10", "name": "Write Job Metadata", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2340, -150], "parameters": { "jsCode": "// Write jobs/{provider}/{stem}.json (batch id + verse index map).\n// fetch-batch later polls/waits and merges results back into chapter files.\nreturn items;" } },
    { "id": "n11", "name": "Exit — Await fetch-batch", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [2600, -150], "parameters": {} },
    { "id": "n12", "name": "LLM Provider", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [2080, 150], "parameters": { "rules": { "values": [
      { "conditions": { "conditions": [ { "leftValue": "={{$json.llmProvider}}", "rightValue": "openai", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "openai" },
      { "conditions": { "conditions": [ { "leftValue": "={{$json.llmProvider}}", "rightValue": "anthropic", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "anthropic" },
      { "conditions": { "conditions": [ { "leftValue": "={{$json.llmProvider}}", "rightValue": "google", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "google" },
      { "conditions": { "conditions": [ { "leftValue": "={{$json.llmProvider}}", "rightValue": "openrouter", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "openrouter" },
      { "conditions": { "conditions": [ { "leftValue": "={{$json.llmProvider}}", "rightValue": "gloo", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "gloo" },
      { "conditions": { "conditions": [ { "leftValue": "={{$json.llmProvider}}", "rightValue": "deepinfra", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "deepinfra" },
      { "conditions": { "conditions": [ { "leftValue": "={{$json.llmProvider}}", "rightValue": "ollama", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "ollama" }
    ] } } },
    { "id": "n13", "name": "Call OpenAI", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2340, -100], "parameters": { "method": "POST", "url": "https://api.openai.com/v1/responses", "options": {} } },
    { "id": "n14", "name": "Call Anthropic", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2340, -30], "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages", "options": {} } },
    { "id": "n15", "name": "Call Google", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2340, 40], "parameters": { "method": "POST", "url": "https://generativelanguage.googleapis.com/v1beta/models", "options": {} } },
    { "id": "n16", "name": "Call OpenRouter", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2340, 110], "parameters": { "method": "POST", "url": "https://openrouter.ai/api/v1/chat/completions", "options": {} } },
    { "id": "n17", "name": "Call Gloo", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2340, 180], "parameters": { "method": "POST", "url": "={{$json.glooEndpoint}}", "options": { "response": { "response": { "responseFormat": "text" } } } } },
    { "id": "n18", "name": "Call DeepInfra", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2340, 250], "parameters": { "method": "POST", "url": "https://api.deepinfra.com/v1/openai/chat/completions", "options": {} } },
    { "id": "n19", "name": "Call Ollama", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2340, 320], "parameters": { "method": "POST", "url": "={{$json.ollamaBaseUrl}}/chat/completions", "options": {} } },
    { "id": "n20", "name": "Merge Provider Response", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2600, 150], "parameters": { "mode": "append", "numberInputs": 7 } },
    { "id": "n21", "name": "Retryable Error?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2860, 150], "parameters": { "conditions": { "conditions": [ { "leftValue": "={{$json.statusCode}}", "rightValue": "408,429,500,502,503,504,520,522,524", "operator": { "type": "string", "operation": "regex" } } ] } } },
    { "id": "n22", "name": "Wait (Exponential Backoff)", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [2860, 320], "parameters": { "amount": "={{2 ** $json.retryAttempt}}", "unit": "seconds" } },
    { "id": "n23", "name": "Retries Exhausted?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [3120, 150], "parameters": { "conditions": { "conditions": [ { "leftValue": "={{$json.retryAttempt}}", "rightValue": "={{$json.maxApiRetries}}", "operator": { "type": "number", "operation": "gte" } } ] } } },
    { "id": "n24", "name": "Split Into Individual Verses", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [3120, 320], "parameters": { "jsCode": "// Split-batch fallback: catch the RuntimeError from an exhausted batch call,\n// log the missed verse ids, and resubmit each verse one at a time\n// (a single-verse call is far less likely to drop mid-stream).\nreturn items;" } },
    { "id": "n25", "name": "Parse Tool-Call Response", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [3380, 150], "parameters": { "jsCode": "// _iter_verse_entries: walk the tool-call 'verses' array, skipping/logging\n// any non-dict entry from malformed model output.\nreturn items;" } },
    { "id": "n26", "name": "Build SB 0.4 Records", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [3640, 150], "parameters": { "jsCode": "// build_output_alignment: convert parsed verse entries into SB 0.4 records\n// (primary/secondary source selectors, NEQ entries, meta.llm block).\nreturn items;" } },
    { "id": "n27", "name": "Write Chapter JSON", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [3900, 150], "parameters": { "jsCode": "// Write {corpus_id}-{edition}-{BB}-{CCC}-manual.json\nreturn items;" } },
    { "id": "n28", "name": "Print Session Cost", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1300, 320], "parameters": {} },
    { "id": "n29", "name": "Done", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1560, 320], "parameters": {} }
  ],
  "connections": {
